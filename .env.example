# Ambiente e modos de execução
ENVIRONMENT=development
DEMO_MODE=true
USE_SUPABASE=false

# Integração Groq (mantenha a chave somente no .env ou no provedor de deploy)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Integração opcional com Supabase. Use a chave service_role somente no backend;
# nunca a exponha no navegador, no repositório ou em variáveis públicas.
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_PUBLISHABLE_KEY=

# E-mails verificados autorizados a acessar o painel de atendentes.
# Em producao, prefira tambem marcar app_metadata.papel=funcionario no Supabase Auth.
FUNCIONARIO_EMAILS=

# Endereco publico do frontend usado no link de recuperacao de senha.
FRONTEND_URL=http://127.0.0.1:5500

# Separe as origens permitidas por vírgula
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5500,http://127.0.0.1:5500,https://vivo-adapt-ai.vercel.app
